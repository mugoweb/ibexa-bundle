{% extends '@ibexadesign/ui/base.html.twig' %}

{% block content %}
	<div>
		<form method="post">

			<div class="btn-group" role="group" aria-label="Quering for content in various methods">

                {#  DbQuery #}
				<input
                        value="DbQuery" type="radio" class="btn-check" name="queryType" id="btnradio1" autocomplete="off"
                        {% if queryType == 'DbQuery' %}checked{% endif %}
                >
				<label class="btn btn-outline-primary" for="btnradio1">DB Query</label>

                {# DbLocationQuery #}
                <input
                        value="DbLocationQuery" type="radio" class="btn-check" name="queryType" id="btnradio2" autocomplete="off"
                        {% if queryType == 'DbLocationQuery' %}checked{% endif %}
                >
                <label class="btn btn-outline-primary" for="btnradio2">DB Location Query</label>

                {# SolrQuery #}
                <input
                        value="SolrQuery" type="radio" class="btn-check" name="queryType" id="btnradio3" autocomplete="off"
                        {% if queryType == 'SolrQuery' %}checked{% endif %}
                >
				<label class="btn btn-outline-primary" for="btnradio3">Solr Query</label>

                {# SolrLocationQuery #}
                <input
                        value="SolrLocationQuery" type="radio" class="btn-check" name="queryType" id="btnradio4" autocomplete="off"
                        {% if queryType == 'SolrLocationQuery' %}checked{% endif %}
                >
                <label class="btn btn-outline-primary" for="btnradio4">Solr Location Query</label>

                {# FilterQuery #}
                <input
                        value="FilterQuery" type="radio" class="btn-check" name="queryType" id="btnradio5" autocomplete="off"
                        {% if queryType == 'FilterQuery' %}checked{% endif %}
                >
                <label class="btn btn-outline-primary" for="btnradio5">Filter Query</label>
			</div>

			<div class="row">
				<div class="col">
					<label>Query:</label>
					<textarea style="width: 100%" name="query">{{ queryString }}</textarea>
				</div>
				<div class="col">
					<select style="max-width: 200px;">
						<option>ContentTypeIdentifier</option>
						<option>MugoWeb\IbexaBundle\API\Repository\Values\Content\Query\Criterion\Field</option>
					</select>
				</div>
			</div>
			<div>
				<label>Sort:</label>
				<input style="width: 100%" name="sort" value="{{ sortString }}" />
				<label>Limit:</label>
				<input style="width: 100%" name="limit" value="{{ limit }}" />
			</div>

			<div>
				<button class="btn btn-primary" name="submit" type="submit" value="1">Submit</button>
			</div>
		</form>

		{% if result %}
			<h2>{{ result.totalCount }} result(s), showing maximal 100</h2>
			<table>
            <tbody>
            {% if result.locations is defined %}
                {% for location in result.locations %}
                    <tr>
                        <td>
                            <a href="{{ ibexa_url( location ) }}">
                                {{ location.contentInfo.name }}
                            </a>
                        </td>
                        <td>
                            {{ location.contentInfo.contentType.name }}
                        </td>
                    </tr>
                {% endfor %}
            {% elseif result.searchHits is defined %}
                {% for hit in result.searchHits %}
                    {% set location = hit.valueObject %}
                    <tr>
                        <td>
                            <a href="{{ ibexa_url( location ) }}">
                                {{ location.contentInfo.name }}
                            </a>
                        </td>
                        <td>
                            {{ location.contentInfo.contentType.name }}
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
            </tbody>
			</table>
		{% endif %}
	</div>
{% endblock %}