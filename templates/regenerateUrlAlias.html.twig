{% extends '@ibexadesign/ui/base.html.twig' %}

{% block content %}
<div>
	<h1>Regenerate URL Aliases</h1>

	<form method="POST">
		<div>
			<label for="locationIdInput">Location ID:</label>
			<input id="locationIdInput" name="locationId" value="" class="form-control" />
		</div>

		<button class="btn btn-primary" name="submit" type="submit" value="1">Submit</button>
	</form>

	{% if message %}
		<h2>Result</h2>
		<div>
			{{ message }}
		</div>
	{% endif %}
</div>
{% endblock %}